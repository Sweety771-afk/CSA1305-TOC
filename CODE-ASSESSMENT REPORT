# ==============================================================

class SmartContractAuditor:

    def __init__(self, code):

        self.code = code
        self.findings = []

    def check_reentrancy(self):

        """
        Very simple pattern-based reentrancy detector.
        This is educational and NOT a production Solidity analyzer.
        """

        if (
            "call" in self.code
            and "balance =" in self.code
        ):

            self.findings.append(
                "Possible reentrancy vulnerability: "
                "external call may occur before state update."
            )

    def check_unchecked_withdrawal(self):

        if (
            "withdraw" in self.code
            and "balance" not in self.code
        ):

            self.findings.append(
                "Withdrawal function may lack balance validation."
            )

    def check_require(self):

        if "require" not in self.code:

            self.findings.append(
                "No require() statement found."
            )

    def check_integer_value(self):

        if "uint" in self.code:

            self.findings.append(
                "Review uint arithmetic for overflow/underflow."
            )

    def run_audit(self):

        print("\n========== SMART CONTRACT AUDIT ==========\n")

        self.check_reentrancy()
        self.check_unchecked_withdrawal()
        self.check_require()
        self.check_integer_value()

        if not self.findings:

            print(
                "[SAFE] No basic pattern-based vulnerabilities found."
            )

        else:

            for number, finding in enumerate(
                self.findings, start=1
            ):

                print(
                    f"[WARNING {number}] {finding}"
                )

        print(
            "\nNote: This is an educational "
            "pattern-based auditor."
        )


