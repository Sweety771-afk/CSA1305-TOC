#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int len;

    printf("Enter the string: ");
    scanf("%s", str);

    len = strlen(str);

    if(len >= 2 && str[0] == '0' && str[len - 1] == '1')
        printf("The string belongs to the grammar.\n");
    else
        printf("The string does not belong to the grammar.\n");

    return 0;
}
