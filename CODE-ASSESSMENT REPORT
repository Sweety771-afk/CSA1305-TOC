import re
from dataclasses import dataclass


# ==============================================================
# PART 1: GRAMMAR DESIGN
# ==============================================================

# Token definitions
TOKEN_SPECIFICATION = [
    ("NUMBER",   r"\d+"),
    ("ID",       r"[A-Za-z_][A-Za-z0-9_]*"),
    ("ASSIGN",   r"="),
    ("PLUS",     r"\+"),
    ("MINUS",    r"-"),
    ("GT",       r">"),
    ("LT",       r"<"),
    ("LPAREN",   r"\("),
    ("RPAREN",   r"\)"),
    ("LBRACE",   r"\{"),
    ("RBRACE",   r"\}"),
    ("SEMICOLON",r";"),
    ("SKIP",     r"[ \t\n]+"),
    ("MISMATCH", r".")
]

TOKEN_REGEX = "|".join(
    f"(?P<{name}>{pattern})"
    for name, pattern in TOKEN_SPECIFICATION
)

KEYWORDS = {
    "contract",
    "function",
    "uint",
    "address",
    "if",
    "else",
    "return",
    "require",
    "true",
    "false",
    "revert"
}


def lexer(code):
    """
    Converts source code into tokens.
    """

    tokens = []

    for match in re.finditer(TOKEN_REGEX, code):

        token_type = match.lastgroup
        token_value = match.group()

        if token_type == "SKIP":
            continue

        elif token_type == "ID" and token_value in KEYWORDS:
            tokens.append((token_value.upper(), token_value))

        elif token_type == "MISMATCH":
            raise SyntaxError(
                f"Unexpected character: {token_value}"
            )

        else:
            tokens.append((token_type, token_value))

    return tokens


