#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int i, len, flag = 0;

    printf("Enter the binary string: ");
    scanf("%s", str);

    len = strlen(str);

    for(i = 0; i <= len - 3; i++)
    {
        if(str[i] == '1' && str[i+1] == '0' && str[i+2] == '1')
        {
            flag = 1;
            break;
        }
    }

    if(flag)
        printf("The string belongs to the grammar.\n");
    else
        printf("The string does not belong to the grammar.\n");

    return 0;
}
