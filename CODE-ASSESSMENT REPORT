@dataclass
class Wallet:

    owner: str
    balance: int = 0

    def deposit(self, amount):

        print(f"\n[EXECUTION] deposit({amount})")

        if amount <= 0:

            print("[ERROR] Deposit amount must be greater than zero.")

            return False

        self.balance += amount

        print(
            f"[SUCCESS] Deposit successful."
            f" Current balance = {self.balance}"
        )

        return True

    def withdraw(self, amount):

        print(f"\n[EXECUTION] withdraw({amount})")

        if amount <= 0:

            print(
                "[ERROR] Withdrawal amount must be greater "
                "than zero."
            )

            return False

        if amount <= self.balance:

            self.balance -= amount

            print(
                f"[SUCCESS] Withdrawal successful."
                f" Current balance = {self.balance}"
            )

            return True

        else:

            print(
                "[REVERT] Insufficient balance."
            )

            return False

    def get_balance(self):

        print(
            f"\n[EXECUTION] getBalance()"
            f"\nBalance = {self.balance}"
        )

        return self.balance


