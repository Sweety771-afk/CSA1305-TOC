class SmartContractDFA:

    def __init__(self):

        # DFA states
        self.states = {
            "q0": "START",
            "q1": "DEPOSIT_CALLED",
            "q2": "VALID_AMOUNT",
            "q3": "BALANCE_UPDATED",
            "q4": "INVALID_AMOUNT",
            "q5": "GET_BALANCE",
            "qf": "FINAL"
        }

        # Transition table
        self.transitions = {

            ("q0", "deposit"):
                "q1",

            ("q1", "amount > 0"):
                "q2",

            ("q1", "amount <= 0"):
                "q4",

            ("q2", "update_balance"):
                "q3",

            ("q3", "getBalance"):
                "q5",

            ("q4", "revert"):
                "qf",

            ("q5", "return_balance"):
                "qf"
        }

        self.current_state = "q0"

    def transition(self, symbol):

        key = (self.current_state, symbol)

        if key not in self.transitions:

            print(
                f"[DFA ERROR] No transition from "
                f"{self.current_state} using {symbol}"
            )

            return False

        new_state = self.transitions[key]

        print(
            f"DFA: {self.current_state}"
            f" --({symbol})--> {new_state}"
        )

        self.current_state = new_state

        return True

    def reset(self):

        self.current_state = "q0"

    def display_states(self):

        print("\n========== DFA STATES ==========\n")

        for state, description in self.states.items():

            print(
                f"{state} : {description}"
            )

    def display_transition_table(self):

        print("\n========== DFA TRANSITION TABLE ==========\n")

        print(
            f"{'Current':<12}"
            f"{'Input':<25}"
            f"{'Next State':<12}"
        )

        print("-" * 50)

        for (state, symbol), next_state in self.transitions.items():

            print(
                f"{state:<12}"
                f"{symbol:<25}"
                f"{next_state:<12}"
            )


# ==============================================================
# PART 4: DFA EXECUTION TRACE
# ==============================================================

def execute_dfa_deposit(amount):

    dfa = SmartContractDFA()

    print("\n========== DFA EXECUTION TRACE ==========\n")

    print(
        f"Initial State: {dfa.current_state}"
    )

    dfa.transition("deposit")

    if amount > 0:

        dfa.transition("amount > 0")

        dfa.transition("update_balance")

        dfa.transition("getBalance")

        dfa.transition("return_balance")

    else:

        dfa.transition("amount <= 0")

        dfa.transition("revert")

    print(
        f"\nFinal DFA State: {dfa.current_state}"
    )


